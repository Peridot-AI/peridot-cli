{
  "name": "peridot-cli",
  "version": "0.4.0",
  "description": "Peridot AI in your terminal",
  "type": "module",
  "bin": {
    "peridot": "src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "build:linux": "bun scripts/build.ts linux",
    "build:macos": "bun scripts/build.ts macos",
    "build:windows": "bun scripts/build.ts windows"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
