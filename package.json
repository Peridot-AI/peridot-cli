{
  "name": "peridot-cli",
  "version": "0.3.0",
  "description": "Peridot AI in your terminal",
  "type": "module",
  "bin": {
    "peridot": "src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/peridot",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/peridot-linux",
    "build:macos": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile dist/peridot-macos",
    "build:windows": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile dist/peridot-windows.exe"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
